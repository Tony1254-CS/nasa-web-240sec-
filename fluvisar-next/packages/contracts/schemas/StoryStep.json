{
  "$defs": {
    "BilingualText": {
      "properties": {
        "en": {
          "description": "English text",
          "title": "En",
          "type": "string"
        },
        "bn": {
          "description": "Reviewed Bangla text in Noto Sans Bengali",
          "title": "Bn",
          "type": "string"
        }
      },
      "required": [
        "en",
        "bn"
      ],
      "title": "BilingualText",
      "type": "object"
    }
  },
  "properties": {
    "step_index": {
      "description": "Step order in chapter",
